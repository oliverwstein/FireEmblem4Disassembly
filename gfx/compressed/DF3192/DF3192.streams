# Compressed streams for rlDecompressor, placed in this order from start to
# end (tools/stream_layout.py), found by tools/find_streams.py. NAME.comp is
# the stream as the ROM has it; gcUnknown... are not identified yet (graphics
# or tilemaps).
start $DF3192
end $DF7FF8

g4bppcBattleBackgroundThicket g4bppcBattleBackgroundThicket ; 16384 bytes decompressed
acBattleBackgroundUnknown17Tilemap acBattleBackgroundUnknown17Tilemap ; 4096 bytes decompressed
# Also used as: acBattleBackgroundForestSnowTilemap.
acBattleBackgroundForestTilemap acBattleBackgroundForestTilemap ; 4096 bytes decompressed
g4bppcBattleAnimationSheetHighPriest g4bppcBattleAnimationSheetHighPriest ; 7488 bytes decompressed
