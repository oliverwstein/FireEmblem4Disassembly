# Compressed streams for rlDecompressor, placed in this order from start to
# end (tools/stream_layout.py), found by tools/find_streams.py. NAME.comp is
# the stream as the ROM has it; gcUnknown... are not identified yet (graphics
# or tilemaps).
start $C00000
end $C03C05

# No pointer to it found, but fe4.cdl shows its first 2 bytes read (perhaps a read through a null long pointer).
acDataC00000Unused acDataC00000Unused ; 17664 bytes decompressed
# Hiragana font (seen in the preview); loaded by rsBattleSceneLoadNameFont and the map battle quotes.
gcHiraganaFont gcHiraganaFont ; 6144 bytes decompressed
# Menu labels and icons (seen in the preview); loaded by rlLoadMenuIconGraphics.
gcMenuLabelsAndIcons gcMenuLabelsAndIcons ; 2048 bytes decompressed
g4bppcMapMenuTiles3400 g4bppcMapMenuTiles3400 ; 1024 bytes decompressed
g4bppcMapBattleHUDTiles g4bppcMapBattleHUDTiles ; 1440 bytes decompressed
g4bppcMapMenuTiles3600 g4bppcMapMenuTiles3600 ; 1024 bytes decompressed
# Unreferenced.
acDataC02786Unused acDataC02786Unused ; 2048 bytes decompressed
g4bppcGameOverTiles g4bppcGameOverTiles ; 3520 bytes decompressed
acGameOverBG1Tilemap acGameOverBG1Tilemap ; 2048 bytes decompressed
acGameOverBG2Tilemap acGameOverBG2Tilemap ; 2048 bytes decompressed
g4bppcMapMagicRippleTiles g4bppcMapMagicRippleTiles ; 3584 bytes decompressed
