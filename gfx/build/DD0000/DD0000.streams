# Compressed streams for rlDecompressor, placed in this order from start to
# end (tools/stream_layout.py), found by tools/find_streams.py. NAME.comp is
# the stream as the ROM has it; gcUnknown... are not identified yet (graphics
# or tilemaps).
start $DD0000
end $DD6655

# Genealogy wheel tiles (Project Naga GenealogyWheel.4bpp; loaded as $DD0000 in bank $89).
gcGenealogyWheelTiles gcGenealogyWheelTiles ; 9728 bytes decompressed
g4bppcReviveScreenTiles g4bppcReviveScreenTiles ; 4608 bytes decompressed
acReviveScreenBG1Tilemap acReviveScreenBG1Tilemap ; 1792 bytes decompressed
acReviveScreenBG2Tilemap acReviveScreenBG2Tilemap ; 2048 bytes decompressed
# Tiles, not a tilemap: rsDataWindowLoadBanners decompresses them and copies each army's banner to VRAM.
g4bppcDataWindowBannerTiles g4bppcDataWindowBannerTiles ; 2048 bytes decompressed
acDataWindowBG1Tilemap acDataWindowBG1Tilemap ; 1792 bytes decompressed
acDataWindowBG2Tilemap acDataWindowBG2Tilemap ; 1216 bytes decompressed
g4bppcOptionsMenuTiles g4bppcOptionsMenuTiles ; 2048 bytes decompressed
acOptionsMenuBG1Tilemap acOptionsMenuBG1Tilemap ; 1792 bytes decompressed
acSkillWindowBG1Tilemap acSkillWindowBG1Tilemap ; 1792 bytes decompressed
acItemWindowBG1Tilemap acItemWindowBG1Tilemap ; 1792 bytes decompressed
acItemWindowBG2Tilemap acItemWindowBG2Tilemap ; 704 bytes decompressed
acMenuWindowBackgroundTilemap acMenuWindowBackgroundTilemap ; 2048 bytes decompressed
g4bppcChapterIntroBG1Tiles g4bppcChapterIntroBG1Tiles ; 16384 bytes decompressed
acChapterIntroBannerTilemaps acChapterIntroBannerTilemaps ; 2304 bytes decompressed
